{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outlook-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Lives at your own domain. thoughtstudio.xyz uses Cloudflare, so deploy sets this up for you.
  "routes": [{ "pattern": "outlook-mcp.thoughtstudio.xyz", "custom_domain": true }],
  // Turn off the extra workers.dev address so there's only one address to sign in through.
  "workers_dev": false,
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Already created on your Cloudflare account
      "id": "b0c8ce4857174932986843bc5ec16005"
    }
  ],
  "vars": {
    // Your calendar's time zone
    "TIME_ZONE": "America/New_York",
    // Only these Microsoft emails can sign in (comma-separated). Put your Outlook email here.
    "ALLOWED_EMAILS": "atreya.pranav@outlook.com"
  },
  "observability": { "enabled": true }
}
